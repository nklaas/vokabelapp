# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API Keys (and Data API for the URL).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx

# Used only by the laptop import script (Claude Code adds vocab as you).
# Never committed: .env.local is git-ignored.
VOCAB_EMAIL=you@example.com
VOCAB_PASSWORD=your-app-password

# Optional, for full backups of all accounts (npm run backup). Supabase -> Project Settings -> API Keys -> Secret key.
# Bypasses all access rules: keep it only in this file, never in the app or on GitHub.
SUPABASE_SECRET_KEY=
